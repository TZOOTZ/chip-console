{
  "name": "tz-megadrive-studio",
  "private": true,
  "version": "1.0.0",
  "description": "TZOOTZ RESEARCH · Chip Console — estudio de chiptune Mega Drive (YM2612 + SN76489) en el navegador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "test:watch": "vitest",
    "test:ref": "vitest run tests/reference.test.ts --mode ref",
    "test:rom": "vitest run tests/rom.test.ts --mode rom",
    "rom:build": "node scripts/build-rom.mjs",
    "typecheck": "tsc -b",
    "deploy": "npm run check && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "licencias": "node scripts/licencias.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "fflate": "^0.8.3",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
